// Prebuilt image with Claude Code, the malloyyo CLI and the Malloy extension.
// Secrets come from the repo's Codespaces secrets (see README step 4).
{
  "name": "Malloy model",
  "image": "ghcr.io/malloydata/malloyyo-devcontainer:latest",
  "postAttachCommand": "malloyyo-devcontainer-info",
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb"
  }
}
