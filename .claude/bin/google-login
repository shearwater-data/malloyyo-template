#!/usr/bin/env bash
# Per-person Google sign-in for building models against BigQuery from a cloud
# session, where there's no browser. See .claude/skills/google-login/SKILL.md.
#
#   google-login start         print a Google sign-in link (waits 10 min for a code)
#   google-login finish CODE   hand over the code from the browser, then write
#                              malloy-config-local.json
#   google-login local-config  (re)write malloy-config-local.json only
#   google-login status        is a Google sign-in active?
set -u
cd "${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}" || exit 1
dir="${TMPDIR:-/tmp}/malloyyo-google-login"

local_config() {
  # malloy-config-local.json replaces malloy-config.json entirely while building
  # here (publish refuses it, and .gitignore keeps it out of git). Same
  # connections, but BigQuery without the service-account key, so it uses the
  # person's Google sign-in.
  jq '.connections |= with_entries(
        if .value.is == "bigquery" then .value |= del(.serviceAccountKeyJson) else . end)' \
    malloy-config.json > malloy-config-local.json &&
    echo "Wrote malloy-config-local.json: BigQuery now uses your Google sign-in."
}

case "${1:-}" in
  start)
    command -v gcloud >/dev/null 2>&1 || { echo "gcloud is not installed here."; exit 1; }
    pkill -f "gcloud.*application-default login" 2>/dev/null
    rm -rf "$dir" && mkdir -p "$dir" && mkfifo "$dir/in"
    # Hold the pipe open so gcloud waits for the code instead of reading EOF.
    nohup sleep 600 > "$dir/in" 2>/dev/null &
    echo $! > "$dir/holder"
    nohup sh -c "gcloud auth application-default login --no-launch-browser < '$dir/in' > '$dir/out' 2>&1; echo \"EXIT=\$?\" >> '$dir/out'" >/dev/null 2>&1 &
    for _ in $(seq 1 20); do
      url=$(grep -o 'https://accounts.google.com[^ ]*' "$dir/out" 2>/dev/null) && break
      sleep 1
    done
    if [ -z "${url:-}" ]; then echo "Couldn't start the sign-in:"; cat "$dir/out"; exit 1; fi
    echo "$url"
    ;;
  finish)
    code="${2:-}"
    [ -p "$dir/in" ] || { echo "No sign-in waiting. Run: google-login start"; exit 1; }
    [ -n "$code" ] || { echo "Usage: google-login finish CODE"; exit 1; }
    printf '%s\n' "$code" > "$dir/in"
    for _ in $(seq 1 30); do grep -q '^EXIT=' "$dir/out" && break; sleep 1; done
    kill "$(cat "$dir/holder")" 2>/dev/null
    if grep -q '^EXIT=0' "$dir/out"; then
      echo "Signed in to Google."
      local_config
    else
      echo "Sign-in failed:"; grep -v '^EXIT=' "$dir/out" | tail -5; exit 1
    fi
    ;;
  local-config) local_config ;;
  status)
    if gcloud auth application-default print-access-token >/dev/null 2>&1; then
      echo "Google sign-in: active"
    else
      echo "Google sign-in: none"; exit 1
    fi
    ;;
  *) sed -n '2,10p' "$0"; exit 1 ;;
esac
