#!/usr/bin/env bash
# Check what this session needs to work with a Malloyyo instance, and say what
# to fix. Prints whether things are set and valid, never their values.
#
#   malloyyo-doctor [INSTANCE_URL]
#
# INSTANCE_URL defaults to $MALLOYYO_URL. Each line starts with OK, MISSING,
# WARN or INFO, so Claude can turn it into a checklist.
cd "${CLAUDE_PROJECT_DIR:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}" || exit 1

url="${1:-${MALLOYYO_URL:-}}"
url="${url%/}"

# Where we're running decides where fixes go.
if [ "${CLAUDE_CODE_REMOTE:-}" = "true" ]; then
  echo "INFO where: Claude cloud session (settings live in the cloud environment)"
elif [ "${CODESPACES:-}" = "true" ]; then
  echo "INFO where: GitHub codespace (settings live in the repo's Codespaces secrets)"
else
  echo "INFO where: this computer (settings live in your shell)"
fi

if command -v malloyyo >/dev/null 2>&1; then
  echo "OK malloyyo CLI $(malloyyo --version 2>/dev/null)"
else
  echo "MISSING malloyyo CLI (install: npm install -g @malloydata/malloyyo)"
fi

# The instance.
if [ -z "$url" ]; then
  echo "MISSING instance URL (no MALLOYYO_URL, and none given)"
else
  case "$url" in
    https://*) ;;
    *) echo "WARN instance URL should start with https:// ($url)" ;;
  esac
  meta=$(curl -sS -m 10 "$url/.well-known/oauth-protected-resource" 2>/dev/null)
  if printf '%s' "$meta" | jq -e '.resource | test("/mcp$")' >/dev/null 2>&1; then
    echo "OK instance answers at $url"
    reachable=1
  else
    echo "MISSING instance does not answer at $url (check the address)"
  fi
  if [ -z "${MALLOYYO_URL:-}" ]; then
    echo "WARN MALLOYYO_URL is not set (should be $url; only needed for codespaces, laptops and publishing from the CLI)"
  elif [ "${MALLOYYO_URL%/}" != "$url" ]; then
    echo "WARN MALLOYYO_URL is ${MALLOYYO_URL%/}, not $url"
  else
    echo "OK MALLOYYO_URL is set to $url"
  fi
fi

# Optional token: only used by .mcp.json's malloyyo_instance (codespaces,
# laptops). Cloud sessions use the instance's claude.ai connector instead.
if [ -n "${MALLOYYO_TOKEN:-}" ] && [ -n "${reachable:-}" ]; then
  code=$(curl -sS -m 10 -o /dev/null -w '%{http_code}' -X POST "$url/mcp" \
    -H "Authorization: Bearer $MALLOYYO_TOKEN" -H 'content-type: application/json' \
    -H 'accept: application/json, text/event-stream' \
    -d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18","capabilities":{},"clientInfo":{"name":"malloyyo-doctor","version":"0"}}}' 2>/dev/null)
  if [ "$code" = "200" ]; then
    echo "OK MALLOYYO_TOKEN is accepted by the instance"
  else
    echo "WARN MALLOYYO_TOKEN is set but the instance rejected it (HTTP $code); it may have expired"
  fi
elif [ -z "${MALLOYYO_TOKEN:-}" ]; then
  echo "INFO MALLOYYO_TOKEN not set (fine in a cloud session: use the instance's claude.ai connector)"
fi

# Secrets the model's connections need.
if [ -f malloy-config.json ]; then
  for name in $(jq -r '[.. | objects | select(has("env")) | .env] | unique[]' malloy-config.json 2>/dev/null); do
    val="${!name:-}"
    if [ -z "$val" ]; then
      echo "MISSING $name is not set (needed to build models locally)"
    elif [[ "$name" == *_JSON ]] &&
         ! printf '%s' "$val" | jq -e . >/dev/null 2>&1 &&
         ! printf '%s' "$val" | base64 -d 2>/dev/null | jq -e . >/dev/null 2>&1; then
      echo "WARN $name is set but is not valid JSON or base64 JSON (store the key base64-encoded)"
    else
      echo "OK $name is set"
    fi
  done
fi

if [ -f malloy-config-local.json ]; then
  echo "INFO malloy-config-local.json is present: it replaces malloy-config.json while building here"
fi
if command -v gcloud >/dev/null 2>&1 &&
   gcloud auth application-default print-access-token >/dev/null 2>&1; then
  echo "INFO personal Google sign-in is active"
fi

remote=$(git remote get-url origin 2>/dev/null | sed -E 's#^.*github\.com[:/]##; s#\.git$##')
[ -n "$remote" ] && echo "INFO repo: $remote"
exit 0
